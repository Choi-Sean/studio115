{
  "name": "studio115",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\" --ignore-path .gitignore",
    "db:generate": "pnpm --filter @studio115/api prisma:generate",
    "db:migrate": "pnpm --filter @studio115/api prisma:migrate",
    "db:seed": "pnpm --filter @studio115/api prisma:seed",
    "db:studio": "pnpm --filter @studio115/api prisma:studio",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3"
  }
}
