# Studio115 — env reference. Copy the relevant block into each app's own .env
# (apps/api/.env, apps/web/.env, apps/admin/.env). See each app's .env.example.

# ────────────── apps/api  (Railway) ──────────────
# DB is Microsoft SQL Server (shared host). Wrap password in {} if it has
# special chars. Schema applied via `prisma db push`.
DATABASE_URL="sqlserver://HOST:1433;database=DB;user=USER;password={PASSWORD};encrypt=true;trustServerCertificate=true"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="1d"
CORS_ORIGINS="https://studio115.example.com,https://admin.studio115.example.com"
PORT=4000
API_PUBLIC_URL="https://api.studio115.example.com"
ADMIN_SEED_EMAIL="admin@studio115.kr"
ADMIN_SEED_PASSWORD="studio115!admin"
ADMIN_SEED_NAME="Studio115 Admin"

# Cloudflare R2 (bucket studio1151, account c8c11b6f0653e467b146a45f884752ab)
STORAGE_DRIVER="s3"
STORAGE_S3_ENDPOINT="https://c8c11b6f0653e467b146a45f884752ab.r2.cloudflarestorage.com"
STORAGE_S3_REGION="auto"
STORAGE_S3_BUCKET="studio1151"
STORAGE_S3_FORCE_PATH_STYLE="true"
STORAGE_S3_ACCESS_KEY_ID=""            # from an R2 API token
STORAGE_S3_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""             # e.g. https://img.studio115.com

# ────────────── apps/web  (Vercel · root: apps/web) ──────────────
NEXT_PUBLIC_API_URL="https://api.studio115.example.com"
NEXT_PUBLIC_SITE_URL="https://studio115.example.com"
NEXT_PUBLIC_IMAGE_CDN=""               # = STORAGE_PUBLIC_BASE_URL
NEXT_PUBLIC_IMAGE_CDN_MODE="cloudflare"

# ────────────── apps/admin  (Vercel · root: apps/admin) ──────────────
# NEXT_PUBLIC_API_URL="https://api.studio115.example.com"
