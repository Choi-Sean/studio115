# Studio115 — env reference. Copy the relevant block into each app's own .env
# (apps/api/.env, apps/web/.env, apps/admin/.env). See each app's .env.example.

# ────────────── apps/api  (Railway) ──────────────
DATABASE_URL="postgresql://studio115:studio115@localhost:5432/studio115?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="1d"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
PORT=4000
API_PUBLIC_URL="http://localhost:4000"
ADMIN_SEED_EMAIL="admin@studio115.kr"
ADMIN_SEED_PASSWORD="studio115!admin"
ADMIN_SEED_NAME="Studio115 Admin"

# Storage: "local" (dev) or "s3" (R2 / NCP / NHN / AWS / Wasabi / B2)
STORAGE_DRIVER="local"
STORAGE_S3_ENDPOINT=""
STORAGE_S3_REGION="auto"
STORAGE_S3_BUCKET="studio115"
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
STORAGE_S3_FORCE_PATH_STYLE="true"
STORAGE_PUBLIC_BASE_URL=""

# ────────────── apps/web  (Vercel) ──────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_IMAGE_CDN=""

# ────────────── apps/admin  (Vercel) ──────────────
# NEXT_PUBLIC_API_URL="http://localhost:4000"
