# Backend API base URL (Railway in prod, local Nest in dev)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Canonical site URL (used for metadata / sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional image CDN base. Leave empty in dev.
# Cloudflare Images / Bunny Optimizer / etc. See src/lib/image-loader.ts
NEXT_PUBLIC_IMAGE_CDN=""
