# ── Studio115 web (Vercel · root directory: apps/web) ──────────
# Backend API base URL (Railway in prod, local Nest in dev)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Canonical site URL (used for metadata / OG)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Image CDN base — the R2 bucket's public domain
# (custom domain e.g. https://img.studio115.com, or the pub-xxxx.r2.dev URL).
# Leave empty in dev to use Next's built-in optimizer with picsum.
NEXT_PUBLIC_IMAGE_CDN=""

# How the CDN resizes:
#   cloudflare = <cdn>/cdn-cgi/image/width=..,quality=../<path>   (needs Cloudflare
#                Transformations enabled on the zone — recommended)
#   query      = <cdn>/<path>?width=..&quality=..&format=auto     (Bunny-style)
#   passthrough= serve originals unresized
NEXT_PUBLIC_IMAGE_CDN_MODE="cloudflare"
