# ── Studio115 API (Railway) ────────────────────────────────────

# Database — self-hosted PostgreSQL (개인 서버). Must be reachable from Railway
# over the public internet (Railway egress IPs are dynamic) or via a tunnel,
# and should use SSL. Append ?sslmode=require (or ?sslmode=no-verify for a
# self-signed cert).
DATABASE_URL="postgresql://studio115:PASSWORD@YOUR-SERVER-HOST:5432/studio115?sslmode=require"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="1d"

# Allowed browser origins — the Vercel web + admin URLs
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Server
PORT=4000
API_PUBLIC_URL="http://localhost:4000"

# Seed admin (used by `pnpm db:seed`)
ADMIN_SEED_EMAIL="admin@studio115.kr"
ADMIN_SEED_PASSWORD="studio115!admin"
ADMIN_SEED_NAME="Studio115 Admin"

# ── Image storage — Cloudflare R2 ──────────────────────────────
# dev: keep "local" (writes to apps/api/uploads/). Railway: set "s3".
STORAGE_DRIVER="local"
STORAGE_S3_ENDPOINT="https://c8c11b6f0653e467b146a45f884752ab.r2.cloudflarestorage.com"
STORAGE_S3_REGION="auto"
STORAGE_S3_BUCKET="studio1151"
STORAGE_S3_FORCE_PATH_STYLE="true"
# From an R2 API token (Cloudflare dashboard → R2 → Manage API Tokens →
# Create → Object Read & Write, scoped to the studio1151 bucket).
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
# Public read URL for the bucket: a custom domain on the bucket
# (e.g. https://img.studio115.com) or the bucket's pub-xxxx.r2.dev URL.
STORAGE_PUBLIC_BASE_URL=""
