# ── Studio115 API ──────────────────────────────────────────────
# Local dev: point this at a Postgres instance. Fastest option is a
# free Railway Postgres (copy its DATABASE_URL here), or `docker compose up -d db`.
DATABASE_URL="postgresql://studio115:studio115@localhost:5432/studio115?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="1d"

# Comma-separated list of allowed browser origins (web + admin)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Server
PORT=4000

# Seed admin (used by `pnpm db:seed`)
ADMIN_SEED_EMAIL="admin@studio115.kr"
ADMIN_SEED_PASSWORD="studio115!admin"
ADMIN_SEED_NAME="Studio115 Admin"
